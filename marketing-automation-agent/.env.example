# Marketing Automation Agent — Environment Variables
# Copy this file to .env and fill in your values

# ============================================================
# REQUIRED
# ============================================================

# Anthropic API (Claude Opus 4.6)
ANTHROPIC_API_KEY=sk-ant-...
AGENT_MODEL=claude-opus-4-6
MAX_TOKENS=4096

# ============================================================
# RECOMMENDED: Image Generation
# ============================================================

# Google AI Studio (Gemini image generation)
# Get your key at: https://aistudio.google.com/apikey
GOOGLE_AI_STUDIO_KEY=AIzaSy...
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
GOOGLE_CLOUD_PROJECT_NUMBER=638639648861

# ============================================================
# OPTIONAL: Platform Content Fetching
# ============================================================

# Twitter/X API v2 Bearer Token
# Get at: https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=AAAA...

# YouTube Data API v3 Key
# Enable at: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=AIzaSy...

# ============================================================
# OPTIONAL: LinkedIn Posting
# Run scripts/setup_linkedin_oauth.py to get these
# ============================================================

LINKEDIN_ACCESS_TOKEN=AQV...
LINKEDIN_ORG_URN=urn:li:organization:XXXXXXXX
LINKEDIN_PERSON_URN=urn:li:person:XXXXXXXX

# ============================================================
# OPTIONAL: Notifications
# ============================================================

NOTIFICATION_EMAIL=your-email@domain.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@domain.com
SMTP_PASSWORD=your-app-password

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ============================================================
# STORAGE & LOGGING
# ============================================================

DATABASE_PATH=data/database/marketing_agent.db
IMAGES_PATH=data/images
LOG_LEVEL=INFO
LOG_PATH=data/logs
